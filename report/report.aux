\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Comparación entre correspondencias sin filtrar y correspondencias retenidas por el criterio combinado en el conjunto \textit  {cuadro}. El filtrado reduce matches ambiguos y conserva asociaciones más consistentes.}}{7}{figure.caption.3}\protected@file@percent }
\newlabel{fig:matching}{{2}{7}{Comparación entre correspondencias sin filtrar y correspondencias retenidas por el criterio combinado en el conjunto \textit {cuadro}. El filtrado reduce matches ambiguos y conserva asociaciones más consistentes}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Homografía manual estimada con DLT y aplicada sobre la imagen completa para el par $0\to 1$ del conjunto \textit  {cuadro}. La alineación se observa principalmente sobre el plano del cuadro.}}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:dlt}{{3}{7}{Homografía manual estimada con DLT y aplicada sobre la imagen completa para el par $0\to 1$ del conjunto \textit {cuadro}. La alineación se observa principalmente sobre el plano del cuadro}{figure.caption.4}{}}
