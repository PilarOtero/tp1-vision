\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Comparación global de las estrategias de matching. El criterio combinado conserva menos correspondencias, pero reduce la distancia media entre descriptores.}}{6}{table.caption.2}\protected@file@percent }
